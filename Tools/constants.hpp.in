/*! \file constants.hpp
 * \brief Physical constants and the share directory
 * \author Wim Cosyn
 * \date 16/08/2011
 *
 * \details Generated by CMake from Tools/constants.hpp.in: edit that file, not constants.hpp.
 *
 * The constants are `inline constexpr` variables in namespace nucqcd (also reachable as
 * nucqcd::constants::name). The old macros (MASSP, HBARC, ...) are kept as aliases of them during the
 * transition (roadmap step 5), so existing code compiles unchanged; new code should use the namespace
 * names. Exceptions: PI stays a literal, because Integrator/numint/macros.hpp defines the same macro
 * and a macro may only be redefined with identical tokens; HOMEDIR stays a string literal.
 *
 * Masses are in MeV unless the name ends in _GeV.
 */

#ifndef CONST_H
#define CONST_H

#include <complex>

namespace nucqcd {
inline namespace constants {

// ---- mathematics and numerics ----
inline constexpr double pi = 3.1415926535897932385;    //!< pi
inline constexpr double deg_to_rad = pi / 180.;        //!< pi/180
inline constexpr double rad_to_deg = 180. / pi;        //!< 180/pi
inline constexpr std::complex<double> i_unit{0., 1.};  //!< imaginary unit
inline constexpr double integration_prec = 1e-04;      //!< default precision of the integrations (macro PREC)
/*! underflow in the code: a double smaller than this should be treated as zero */
inline constexpr double strange_underflow = 1.0e-12;

// ---- conversion and couplings ----
inline constexpr double hbarc = 197.327;               //!< hbar*c [MeV fm]
inline constexpr double inv_hbarc = 1. / hbarc;        //!< (hbar*c)^-1 [(MeV fm)^-1]
inline constexpr double alpha_em = 0.00729735253;      //!< fine-structure constant
inline constexpr double mu_p = 2.79;                   //!< proton magnetic moment [nuclear magnetons]
inline constexpr double sin2_theta_w = 0.2224;         //!< sin^2 of the Weinberg angle
inline constexpr double g_fermi = 1.16637E-11;         //!< Fermi coupling constant [MeV^-2]
inline constexpr double cos_cabibbo = 0.97427;         //!< V_ud, cosine of the Cabibbo angle

// ---- nucleons and nuclei ----
inline constexpr double mass_n = 939.56536;                        //!< neutron mass [MeV]
inline constexpr double mass_p = 938.27231;                        //!< proton mass [MeV]
inline constexpr double mass_nucleon = 0.5 * (mass_n + mass_p);    //!< average nucleon mass [MeV]
inline constexpr double mass_n_GeV = 939.56536E-03;                //!< neutron mass [GeV]
inline constexpr double mass_p_GeV = 938.27231E-03;                //!< proton mass [GeV]
inline constexpr double mass_nucleon_GeV = 0.5 * (mass_n_GeV + mass_p_GeV);  //!< average nucleon mass [GeV]
inline constexpr double mass_d = 1875.6;                           //!< deuteron mass [MeV]
inline constexpr double mass_d_GeV = 1875.6E-03;                   //!< deuteron mass [GeV]
inline constexpr double mass_he3 = 2809.41338;                     //!< He3 mass [MeV]

// ---- mesons, hyperons and bosons [MeV] ----
inline constexpr double mass_pi = 139.57;        //!< charged pion mass
inline constexpr double mass_pi0 = 134.977;      //!< neutral pion mass
inline constexpr double mass_rho = 775.26;       //!< rho(770) mass, PDG 2022-2026 average (775.49 until 2026-11, PDG 2012)
inline constexpr double mass_omega = 782.65;     //!< omega mass
inline constexpr double mass_phi = 1019.46;      //!< phi mass
inline constexpr double mass_kp = 493.677;       //!< K+ mass
inline constexpr double mass_k0 = 497.672;       //!< K0 mass
inline constexpr double mass_lambda = 1115.683;  //!< Lambda mass
inline constexpr double mass_sigma0 = 1192.642;  //!< Sigma0 mass
inline constexpr double mass_sigmap = 1189.37;   //!< Sigma+ mass
inline constexpr double mass_sigmam = 1197.449;  //!< Sigma- mass
inline constexpr double mass_z = 91187.6;        //!< Z boson mass
inline constexpr double mass_w = 80385.;         //!< W boson mass

// ---- data ----
inline constexpr const char *share_dir = "@SHARE_DIR@";  //!< absolute path of the share/ directory of the repository (macro HOMEDIR)

}  // namespace constants
}  // namespace nucqcd

// ---- macro aliases (transition; prefer the nucqcd:: names in new code) ----
#define PI 3.1415926535897932385 /*!< pi; a literal, identical to Integrator/numint/macros.hpp */
#define PREC nucqcd::integration_prec /*!< see nucqcd::integration_prec */
#define MASSN nucqcd::mass_n /*!< see nucqcd::mass_n */
#define MASSP nucqcd::mass_p /*!< see nucqcd::mass_p */
#define MASSn nucqcd::mass_nucleon /*!< see nucqcd::mass_nucleon */
#define MASSN_G nucqcd::mass_n_GeV /*!< see nucqcd::mass_n_GeV */
#define MASSP_G nucqcd::mass_p_GeV /*!< see nucqcd::mass_p_GeV */
#define MASSn_G nucqcd::mass_nucleon_GeV /*!< see nucqcd::mass_nucleon_GeV */
#define MASSPI nucqcd::mass_pi /*!< see nucqcd::mass_pi */
#define MASSRHO nucqcd::mass_rho /*!< see nucqcd::mass_rho */
#define HBARC nucqcd::hbarc /*!< see nucqcd::hbarc */
#define ALPHA nucqcd::alpha_em /*!< see nucqcd::alpha_em */
#define I_UNIT nucqcd::i_unit /*!< see nucqcd::i_unit */
#define INVHBARC nucqcd::inv_hbarc /*!< see nucqcd::inv_hbarc */
#define MUP nucqcd::mu_p /*!< see nucqcd::mu_p */
#define DEGRTORAD nucqcd::deg_to_rad /*!< see nucqcd::deg_to_rad */
#define RADTODEGR nucqcd::rad_to_deg /*!< see nucqcd::rad_to_deg */
#define MASSD nucqcd::mass_d /*!< see nucqcd::mass_d */
#define MASSD_G nucqcd::mass_d_GeV /*!< see nucqcd::mass_d_GeV */
#define MASSHE3 nucqcd::mass_he3 /*!< see nucqcd::mass_he3 */
#define SIN2W nucqcd::sin2_theta_w /*!< see nucqcd::sin2_theta_w */
#define STRANGEUFLOW nucqcd::strange_underflow /*!< see nucqcd::strange_underflow */
// second set of names (from the kinematics classes and NuclStructure)
#define M_P nucqcd::mass_p /*!< see nucqcd::mass_p */
#define M_N nucqcd::mass_n /*!< see nucqcd::mass_n */
#define M_NUCL nucqcd::mass_nucleon /*!< see nucqcd::mass_nucleon */
#define M_KP nucqcd::mass_kp /*!< see nucqcd::mass_kp */
#define M_K0 nucqcd::mass_k0 /*!< see nucqcd::mass_k0 */
#define M_L nucqcd::mass_lambda /*!< see nucqcd::mass_lambda */
#define M_S0 nucqcd::mass_sigma0 /*!< see nucqcd::mass_sigma0 */
#define M_SP nucqcd::mass_sigmap /*!< see nucqcd::mass_sigmap */
#define M_SM nucqcd::mass_sigmam /*!< see nucqcd::mass_sigmam */
#define M_RHO nucqcd::mass_rho /*!< see nucqcd::mass_rho */
#define M_OMEGA nucqcd::mass_omega /*!< see nucqcd::mass_omega */
#define M_PHI nucqcd::mass_phi /*!< see nucqcd::mass_phi */
#define M_PIP nucqcd::mass_pi /*!< see nucqcd::mass_pi */
#define M_PIM nucqcd::mass_pi /*!< see nucqcd::mass_pi */
#define M_PI0 nucqcd::mass_pi0 /*!< see nucqcd::mass_pi0 */
#define G_FERMI nucqcd::g_fermi /*!< see nucqcd::g_fermi */
#define M_Z nucqcd::mass_z /*!< see nucqcd::mass_z */
#define M_W nucqcd::mass_w /*!< see nucqcd::mass_w */
#define COS_CAB nucqcd::cos_cabibbo /*!< see nucqcd::cos_cabibbo */

#define HOMEDIR "@SHARE_DIR@" /*!< absolute path of the share/ directory of the repository, see nucqcd::share_dir */

#endif

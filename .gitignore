bin/
build/
doc/
lib/
Tools/Core/constants.hpp
manual/*.pdf
share/statefile/
share/grids/
share/gpd_deutgrids/
.vscode/ipch/

# get rid of mac folder info files
#
.DS_Store

# get rid of backups on ubuntu, often suffixed by tilde ~
#
*~
# get rid of .aux, .log files of latex builds
#
*.aux
*.log
# ignore compiled python modules
#
*.pyc

# ignore .orig files from indentation
# using astyle
*.orig

#ignore object files and libs
*.o
*.so
*.mod
# test suite: lock/temp files of the golden-value store
tests/reference/*.lock
tests/reference/*.tmp

# editor/IDE state and backups
.vscode/.cmaketools.json
.vscode/c_cpp_properties.json
.directory
*.backup
# build outputs written into the source tree
*.out

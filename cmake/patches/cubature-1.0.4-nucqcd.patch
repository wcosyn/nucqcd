+/* nucqcd addition: as hcubature, with a minimum number of function evaluations (the interface of the 2010 adapt_integrate
+   that nucqcd used before): convergence is only accepted after more than minEval evaluations */
+int hcubature_minEval(unsigned fdim, integrand f, void *fdata,
+		      unsigned dim, const double *xmin, const double *xmax,
+		      size_t minEval, size_t maxEval, double reqAbsError, double reqRelError,
+		      error_norm norm,
+		      double *val, double *err)
+{
+     int ret;
+     fv_data d;
+
+     if (fdim == 0) return SUCCESS; /* nothing to do */
+
+     d.f = f; d.fdata = fdata;
+     ret = cubature(fdim, fv, &d, dim, xmin, xmax,
+		    minEval, maxEval, reqAbsError, reqRelError, norm, val, err, 0);
      return ret;
 }
 

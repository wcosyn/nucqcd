+/* nucqcd addition: as hcubature, with a minimum number of function evaluations: convergence is only accepted after more
+   than minEval evaluations (the 2010 adapt_integrate that nucqcd used had this argument) */
+int hcubature_minEval(unsigned fdim, integrand f, void *fdata,
+                      unsigned dim, const double *xmin, const double *xmax,
+                      size_t minEval, size_t maxEval,
+                      double reqAbsError, double reqRelError,
+                      error_norm norm,
+                      double *val, double *err);
+
 /* as hcubature, but vectorized integrand */
 int hcubature_v(unsigned fdim, integrand_v f, void *fdata,
 		unsigned dim, const double *xmin, const double *xmax, 

# Writes the git state of the source tree into ${OUT} (a C++ fragment included by Tools/RunLog.cpp).
# Run at every build (custom target nucqcd_git_info); the file is only rewritten when the state
# changes, so nothing is recompiled otherwise.  Usage: cmake -DSRC=<source dir> -DOUT=<file> -P BuildInfo.cmake
find_package(Git QUIET)
set(describe "unknown (no git)")
set(date "unknown")
if(GIT_FOUND AND EXISTS "${SRC}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" describe --always --dirty --abbrev=12
                  OUTPUT_VARIABLE describe OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r1)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" log -1 --format=%cI
                  OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r2)
  if(NOT r1 EQUAL 0)
    set(describe "unknown (git describe failed)")
  endif()
  if(NOT r2 EQUAL 0)
    set(date "unknown")
  endif()
endif()
set(content "// generated by cmake/BuildInfo.cmake at build time, do not edit\n#define NUCQCD_GIT_DESCRIBE \"${describe}\"\n#define NUCQCD_GIT_DATE \"${date}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
